{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ],
      "source": "/static/(.*)"
    }
  ],
  "regions": [
    "iad1"
  ],
  "rewrites": [
    {
      "destination": "/api/index",
      "source": "/(.*)"
    }
  ]
}
